# 复制为 .env 后填写。.env 不要提交到仓库。

# 不填 Key 时自动用离线规则模型（MODEL_MODE=auto）；填了就走 DeepSeek 云端 API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # 值班长 + 故障诊断
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash  # 告警分诊
# MODEL_MODE=auto                       # auto | offline | deepseek

# 只读 MCP 服务：默认 stdio 子进程；也可单独起 HTTP 服务后改成 http
MCP_TRANSPORT=stdio
# MCP_URL=http://127.0.0.1:8765/mcp
# MCP_CALLER_SCOPES=bess:alarms:read bess:telemetry:read bess:assets:read bess:maintenance:read bess:knowledge:read bess:weather:read
# MCP_QUERY_BUDGET=60

# 企业微信群机器人（不填只生成草稿，不发送）
WECOM_WEBHOOK_URL=

# 离线模式下每步停顿秒数，方便在界面上看清过程
OFFLINE_STEP_DELAY=0.4
